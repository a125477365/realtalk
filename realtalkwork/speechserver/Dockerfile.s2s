# HuggingFace speech-to-speech 原生 Realtime sidecar。
# 容器本身就是隔离运行环境，不需要也不创建 Python venv；所有模型缓存挂在 /models。
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/models/hf-cache \
    TRANSFORMERS_CACHE=/models/hf-cache \
    XDG_CACHE_HOME=/models/cache \
    TOKENIZERS_PARALLELISM=false

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates ffmpeg libgomp1 libsndfile1 curl \
    && rm -rf /var/lib/apt/lists/*

# 强制 CPU PyTorch：不要让 pip 从 PyPI 换成携 CUDA runtime 的包。上游当前版本虽然
# 声明 faster-qwen3-tts[ggml]，但 pip 不会稳定解析其 qwentts.cpp 可选轮子；因此显式
# 固定官方维护者提供的 CPU wheel（py3 ABI 无关），避免实时服务首启时 ImportError。
RUN pip install --index-url https://download.pytorch.org/whl/cpu \
      "torch==2.7.1+cpu" "torchaudio==2.7.1+cpu" \
    && pip install --find-links https://huggingface.co/datasets/andito/qwentts-cpp-python-wheels/tree/main/whl/cpu \
      "qwentts-cpp-python==0.3.0+cpu" \
    && pip install "speech-to-speech[faster-whisper]==0.2.10" \
    && python -c "import nltk; nltk.download('punkt_tab'); nltk.download('averaged_perceptron_tagger_eng')"

WORKDIR /srv
COPY s2s-entrypoint.sh ./
RUN chmod +x /srv/s2s-entrypoint.sh

VOLUME /models
EXPOSE 8765
HEALTHCHECK --interval=30s --timeout=5s --start-period=300s --retries=8 \
  CMD curl -fs http://127.0.0.1:8765/v1/pool || exit 1

ENTRYPOINT ["/srv/s2s-entrypoint.sh"]
