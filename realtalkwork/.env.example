# ====================================================================
# 参数来源分类（每个参数只有一个来源，不存在「先 DB 后文件」的优先级）：
#
#  A. 数据库存储（系统级、所有后端节点共用）：AI 模型 / 实时语音 / ASR 云端 / 各类价格 /
#     每日限额 / 额度比例 / 套餐目录 / 预估参数。
#     —— 这些「只在新建数据库时」于 setup.sh 询问，首次启动写入数据库后即以数据库为唯一来源
#        （管理台「系统设置」管理）。本文件里这些项仅作为「新建库首次落库」的初值，落库后不再读取。
#        连接已有数据库的节点无需也不应再设置它们。
#
#  B. 本地配置文件（系统级、所有节点共用，但不入库）：数据库连接与凭据、JWT 密钥、内部令牌、
#     管理员账号、Redis、SMTP、各支付密钥。建库与后端服务都要用 → 每个节点都要配。
#  C. 本地配置文件（每台节点各不相同）：worker 进程数(≈CPU)、连接池、compose profile、数据目录。
#  D. 本地配置文件（仅本节点自用）：各端口、Web 访问后端地址等。
# ====================================================================

# 本地开发默认 SQLite。生产/多中心部署请改用 DATABASE_URL，连接 PostgreSQL 协议数据库集群。
REALTALK_DB=./realtalk.sqlite3
# 示例：
# DATABASE_URL=postgresql+psycopg://root@cockroach:26257/realtalk?sslmode=disable
# DATABASE_URL=postgresql+psycopg://app_user:password@yugabyte.example.com:5433/realtalk?sslmode=require
DATABASE_URL=
REALTALK_REGION=local
# JWT 签名密钥：生产必须设为长随机串（否则任何人可伪造登录令牌）。
# 留空 / 用占位值时，后端会自动落到持久化随机密钥文件 .jwt_secret.key 兜底。
JWT_SECRET=replace-with-a-long-random-secret
JWT_SECRET_FILE=.jwt_secret.key
TOKEN_TTL_HOURS=720

# ==================== 采集分块暂存 Redis ====================
# 对话采集分块的临时暂存（带 TTL 自动回收、用完即删、不写主库）。
# 留空 = 回退本地文件（仅单机够用）；多节点部署务必配 Redis 以便跨节点共享。
# 示例：redis://redis:6379/0  或  redis://:密码@host:6379/0  （TLS 用 rediss://）
REDIS_URL=
# 内置 Redis 容器的数据目录（docker-compose backend-redis profile 使用）
REDIS_DATA_DIR=./data/redis
RETENTION_DAYS=3
HISTORY_RETENTION_DAYS=90
ROLEPLAY_ACCEPT_SCORE=0.72
REQUIRE_PRO_FOR_AI=false
EMAIL_CODE_TTL_MINUTES=10
EMAIL_DEV_MODE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=RealTalk <noreply@realtalk.local>

PAYMENT_RECEIVER_NAME=你的收款名称
WECHAT_RECEIVER_ACCOUNT=
ALIPAY_RECEIVER_ACCOUNT=
WECHAT_PAY_URL=
ALIPAY_PAY_URL=
PAYMENT_DEV_AUTO_CONFIRM=true
WECHAT_AUTH_DEV_MODE=true
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 文字 AI 模型服务（也可在管理台「系统设置 → AI 模型对接」配置，管理台配置优先生效）
# 智谱 GLM / Z.ai 示例：
# AI_BASE_URL=https://api.z.ai/api/paas/v4
# AI_MODEL=glm-4.7-flash
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_SECONDS=40
# 成本估算单价（分/百万 tokens），用于管理台「数据概览」支出统计
AI_INPUT_PRICE_PER_1M_CENTS=80
AI_OUTPUT_PRICE_PER_1M_CENTS=200

# 高级会员实时语音大模型（OpenAI 兼容 Realtime API，WebSocket）。也可在管理台「系统设置」配置。
# 后端只做转发 + 场景/护栏指令注入 + 结束评分，未配置 API Key 时该功能不可用。
REALTIME_BASE_URL=wss://api.openai.com/v1/realtime
REALTIME_API_KEY=
REALTIME_MODEL=gpt-4o-realtime-preview
REALTIME_VOICE=alloy
# 实时语音计费单价（分/百万 token），文本/音频分开（音频远贵于文本，按你的模型官方报价填）。
# 用量计入用户「当月费用额度」（= 会员月费的 50%），也可在管理台「系统设置」在线配置。
REALTIME_INPUT_TEXT_PRICE_PER_1M_CENTS=400
REALTIME_INPUT_AUDIO_PRICE_PER_1M_CENTS=2800
REALTIME_OUTPUT_TEXT_PRICE_PER_1M_CENTS=1600
REALTIME_OUTPUT_AUDIO_PRICE_PER_1M_CENTS=5600

# ==================== 会员与配额 ====================
# 新用户免费试用天数（注册自动获得基础会员）
TRIAL_DAYS=30
# 月度 token 费用额度 = 购买会员时档位标准月费 × 该比例（0~1，剩余为项目利润）。管理台可在线改、实时生效。
# 旧用户按其购买会员时锁定的月费计算额度；改价只影响之后新购/续费的用户。
BUDGET_RATIO=0.5
# 非会员（免费）每日限额（管理台可在线改、实时生效）：文字模型对话 token、采集文字输入 token、采集时长秒
NONMEMBER_DAILY_CHAT_TOKENS=1000
NONMEMBER_DAILY_CAPTURE_TOKENS=1000
NONMEMBER_DAILY_CAPTURE_SECONDS=300
# 每日 token 限额（按生效套餐；0=不限制；管理台可在线覆盖）
DAILY_TOKEN_LIMIT_FREE=8000
DAILY_TOKEN_LIMIT_BASIC=120000
DAILY_TOKEN_LIMIT_PREMIUM=400000

# ==================== 语音转写 ASR（高级会员上传录音用）====================
# OpenAI 兼容 /audio/transcriptions 服务；管理台「系统设置」可在线配置覆盖
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
# 开发模式：未配置 ASR 时用示例文本跑通流程（生产请设为 false）
ASR_DEV_MODE=false
# 上传目录与上限
UPLOAD_DIR=./uploads
AUDIO_MAX_BYTES=314572800
AUDIO_MAX_SECONDS=21600

# ==================== 并发 ====================
# uvicorn worker 进程数（Docker CMD 使用，建议 = CPU 核数）
WEB_CONCURRENCY=4
# PostgreSQL 连接池（每 worker）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Docker Compose 端口与数据库（docker-compose.yml 使用）
API_PORT=8000
ADMIN_PORT=8001
POSTGRES_USER=realtalk
POSTGRES_PASSWORD=realtalk
POSTGRES_DB=realtalk
POSTGRES_DATA_DIR=./data/postgres
COMPOSE_NETWORK_NAME=realtalk
COMPOSE_SUBNET=172.28.0.0/16

# 火山方舟：普通模型调用；未配置 AI_* 时自动使用 ARK_* 作为模型配置
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-1-6-251015

# 火山方舟：如果创建了应用/Bot，填 Bot ID 后会调用 /bots/chat/completions
ARK_BOT_ID=
ARK_TIMEOUT_SECONDS=40

# Apple IAP
APPLE_PRODUCT_ID=realtalk.pro.monthly
APPLE_BUNDLE_ID=com.realtalk.app
APPLE_USE_SANDBOX=true
APPLE_IAP_DEV_BYPASS=true

# 生产环境服务端验证需要 App Store Server API 密钥
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ==================== 微信支付（原生支付）====================
WECHAT_MCHID=
WECHAT_API_KEY=
WECHAT_SSL_CERT_PATH=
WECHAT_SSL_KEY_PATH=
WECHAT_NOTIFY_URL=https://your-domain.com/payment/wechat/webhook

# ==================== 支付宝（当面付）====================
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SANDBOX=false
ALIPAY_NOTIFY_URL=https://your-domain.com/payment/alipay/webhook

# ==================== 邮件重置密码链接====================
APP_BASE_URL=https://realtalk.app

# ==================== 管理端 ====================
# 管理后台前端地址（用于跨域配置）
ADMIN_FRONTEND_URL=http://localhost:8080
# 管理后台账号（默认 admin / admin123456）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
