<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="33">

    <!--
      Google 助手 App Actions：把内置语音意图映射到「开始/结束录音」。
      用户也可长按桌面图标直接看到这两个快捷指令，或对助手说出 shortcutLongLabel
      （如「在 RealTalk 开始录音」「结束 RealTalk 录音」）触发，无需先打开 App。
      与 iOS 端 RealTalkShortcuts（Siri）一一对应。
    -->
    <capability android:name="actions.intent.START_EXERCISE">
        <intent
            android:action="com.example.realtalkad.action.START_CAPTURE"
            android:targetPackage="com.example.realtalkad"
            android:targetClass="com.example.realtalkad.MainActivity" />
    </capability>

    <capability android:name="actions.intent.STOP_EXERCISE">
        <intent
            android:action="com.example.realtalkad.action.STOP_CAPTURE"
            android:targetPackage="com.example.realtalkad"
            android:targetClass="com.example.realtalkad.MainActivity" />
    </capability>

    <shortcut
        android:shortcutId="start_capture"
        android:enabled="true"
        android:icon="@drawable/ic_mic"
        android:shortcutShortLabel="@string/shortcut_start_short"
        android:shortcutLongLabel="@string/shortcut_start_long">
        <intent
            android:action="com.example.realtalkad.action.START_CAPTURE"
            android:targetPackage="com.example.realtalkad"
            android:targetClass="com.example.realtalkad.MainActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <shortcut
        android:shortcutId="stop_capture"
        android:enabled="true"
        android:icon="@drawable/ic_stop"
        android:shortcutShortLabel="@string/shortcut_stop_short"
        android:shortcutLongLabel="@string/shortcut_stop_long">
        <intent
            android:action="com.example.realtalkad.action.STOP_CAPTURE"
            android:targetPackage="com.example.realtalkad"
            android:targetClass="com.example.realtalkad.MainActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
