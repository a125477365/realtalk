# smartOM 工单技能配置（复制为 config.env 后填写；config.env 勿提交到仓库）

# 本项目数据库（与后端 realtalkwork 相同）。二选一：
#   PostgreSQL：postgresql+psycopg://user:password@host:5432/realtalk?sslmode=disable
#   本地 SQLite：sqlite:////绝对路径/realtalk.sqlite3
DATABASE_URL=

# 代码仓库（缺陷工单核验时只读浅克隆）。私有库无凭据时向运维索取只读账号或带 token 的 URL。
REPO_URL=https://github.com/a125477365/realtalk.git
# 可选：私有库的只读 token（HTTPS 克隆用），留空则用 REPO_URL 自带凭据
REPO_TOKEN=

# 报告推送渠道（任选其一或都填）
# 飞书自定义机器人 Webhook
FEISHU_WEBHOOK=
# 企业微信群机器人 Webhook
WECHAT_WEBHOOK=
